page {
  min-height: 100%;
  color: #263238;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #fff8ef;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.section {
  margin-top: 30rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title-main {
  color: #263238;
  font-size: 34rpx;
  font-weight: 800;
}

.section-title-more {
  color: #25b6a4;
  font-size: 24rpx;
  font-weight: 700;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(38, 50, 56, 0.06);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 34rpx rgba(38, 50, 56, 0.07);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  background: #f97361;
  border-radius: 18rpx;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 24rpx;
  color: #263238;
  font-size: 26rpx;
  font-weight: 700;
  background: #ffffff;
  border: 1rpx solid rgba(38, 50, 56, 0.08);
  border-radius: 16rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 14rpx;
  color: #25b6a4;
  font-size: 22rpx;
  font-weight: 700;
  background: #e8f7f2;
  border-radius: 999rpx;
}

.price {
  color: #f97361;
  font-size: 34rpx;
  font-weight: 900;
}

.muted {
  color: #6b7680;
}
