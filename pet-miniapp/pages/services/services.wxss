.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.heading-kicker {
  color: #25b6a4;
  font-size: 22rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.heading-title {
  margin-top: 8rpx;
  color: #263238;
  font-size: 38rpx;
  font-weight: 900;
}

.heading-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 64rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  background: #f97361;
  border-radius: 999rpx;
}

.category-scroll {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.category-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 66rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  color: #6b7680;
  font-size: 25rpx;
  font-weight: 800;
  background: #ffffff;
  border: 1rpx solid rgba(38, 50, 56, 0.08);
  border-radius: 999rpx;
}

.category-pill.active {
  color: #ffffff;
  background: #263238;
}

.service-list {
  display: grid;
  gap: 20rpx;
}

.service-item {
  overflow: hidden;
}

.service-image {
  width: 100%;
  height: 280rpx;
}

.service-content {
  padding: 24rpx;
}

.service-top,
.service-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.service-name {
  color: #263238;
  font-size: 32rpx;
  font-weight: 900;
}

.service-suitable {
  margin-top: 8rpx;
  color: #6b7680;
  font-size: 23rpx;
}

.price text {
  margin-left: 4rpx;
  font-size: 22rpx;
}

.service-summary {
  margin-top: 18rpx;
  color: #56636c;
  font-size: 26rpx;
  line-height: 1.6;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.service-bottom {
  margin-top: 24rpx;
}

.book-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 68rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  background: #25b6a4;
  border-radius: 999rpx;
}
