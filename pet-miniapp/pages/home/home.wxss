.home-page {
  padding-top: 22rpx;
}

.hero {
  position: relative;
  min-height: 420rpx;
  overflow: hidden;
  background:
    linear-gradient(105deg, rgba(38, 50, 56, 0.78), rgba(38, 50, 56, 0.08)),
    url("https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=1200&q=80") center/cover;
  border-radius: 28rpx;
}

.hero-copy {
  width: 68%;
  padding: 48rpx 34rpx;
  color: #ffffff;
}

.store-status {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  color: #263238;
  font-size: 22rpx;
  font-weight: 800;
  background: #a9fff2;
  border-radius: 999rpx;
}

.brand-name {
  margin-top: 28rpx;
  font-size: 68rpx;
  font-weight: 900;
  line-height: 1;
}

.brand-slogan {
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 188rpx;
  height: 72rpx;
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  background: #f97361;
  border-radius: 999rpx;
}

.notice {
  display: flex;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx;
}

.notice-title {
  flex: 0 0 auto;
  color: #f97361;
  font-size: 25rpx;
  font-weight: 800;
}

.notice-list {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 16rpx;
}

.notice-item {
  padding-left: 18rpx;
  border-left: 6rpx solid #25b6a4;
}

.notice-item.important {
  border-left-color: #f97361;
}

.notice-item-title {
  color: #263238;
  font-size: 26rpx;
  font-weight: 800;
}

.notice-text {
  color: #6b7680;
  font-size: 25rpx;
  line-height: 1.6;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 142rpx;
}

.quick-icon {
  display: grid;
  width: 58rpx;
  height: 58rpx;
  place-items: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #25b6a4;
  border-radius: 20rpx;
}

.quick-label {
  margin-top: 12rpx;
  color: #263238;
  font-size: 24rpx;
  font-weight: 700;
}

.service-scroll {
  width: 100%;
  white-space: nowrap;
}

.service-card {
  display: inline-block;
  width: 560rpx;
  margin-right: 18rpx;
  overflow: hidden;
  vertical-align: top;
}

.service-cover {
  width: 100%;
  height: 250rpx;
}

.service-body {
  padding: 22rpx;
}

.service-name {
  color: #263238;
  font-size: 30rpx;
  font-weight: 800;
}

.service-summary {
  min-height: 72rpx;
  margin-top: 12rpx;
  color: #6b7680;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: normal;
}

.service-foot,
.product-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.price text {
  font-size: 22rpx;
  font-weight: 700;
}

.today-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  background: #263238;
}

.today-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
}

.today-desc {
  width: 420rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.55;
}

.today-button {
  width: 190rpx;
  background: #25b6a4;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.product-card {
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 210rpx;
}

.product-name {
  min-height: 72rpx;
  padding: 18rpx 18rpx 0;
  color: #263238;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
}

.product-row {
  padding: 0 18rpx 20rpx;
}

.product-stock {
  color: #6b7680;
  font-size: 22rpx;
}
