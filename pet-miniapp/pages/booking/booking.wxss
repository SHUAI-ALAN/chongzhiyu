.booking-head {
  padding: 12rpx 2rpx 26rpx;
}

.heading-kicker {
  color: #25b6a4;
  font-size: 22rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.heading-title {
  margin-top: 8rpx;
  color: #263238;
  font-size: 40rpx;
  font-weight: 900;
}

.heading-desc {
  margin-top: 12rpx;
  color: #6b7680;
  font-size: 25rpx;
}

.form-card {
  padding: 26rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #263238;
  font-size: 25rpx;
  font-weight: 800;
}

.field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

input,
textarea,
.picker-value {
  width: 100%;
  min-height: 82rpx;
  padding: 0 22rpx;
  color: #263238;
  font-size: 27rpx;
  background: #f7faf9;
  border: 1rpx solid rgba(38, 50, 56, 0.08);
  border-radius: 16rpx;
}

textarea {
  min-height: 150rpx;
  padding-top: 20rpx;
  line-height: 1.5;
}

.picker-value {
  display: flex;
  align-items: center;
}

.date-scroll {
  white-space: nowrap;
}

.date-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 104rpx;
  margin-right: 14rpx;
  color: #6b7680;
  background: #ffffff;
  border: 1rpx solid rgba(38, 50, 56, 0.08);
  border-radius: 18rpx;
}

.date-pill text:first-child {
  color: #263238;
  font-size: 28rpx;
  font-weight: 900;
}

.date-pill text:last-child {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.date-pill.active {
  color: #ffffff;
  background: #263238;
}

.date-pill.active text {
  color: #ffffff;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.time-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: #263238;
  font-size: 26rpx;
  font-weight: 800;
  background: #ffffff;
  border: 1rpx solid rgba(38, 50, 56, 0.08);
  border-radius: 16rpx;
}

.time-pill.active {
  color: #ffffff;
  background: #25b6a4;
}

.time-pill.disabled {
  color: #b7c0c5;
  background: #eef2f1;
}

.submit-button {
  margin-top: 8rpx;
}
