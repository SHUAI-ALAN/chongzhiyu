<view class="page">
  <view class="shop-head">
    <view>
      <view class="heading-kicker">Shop</view>
      <view class="heading-title">门店精选用品</view>
    </view>
    <view class="cart-chip">购物袋 {{cartCount}}</view>
  </view>

  <scroll-view scroll-x class="category-scroll" show-scrollbar="{{false}}">
    <view
      class="category-pill {{activeCategory === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="selectCategory"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <view class="product-list">
    <view class="product-card card" wx:for="{{products}}" wx:key="id">
      <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="product-info">
        <view class="product-name">{{item.name}}</view>
        <view class="tag-row">
          <view class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="product-bottom">
          <view>
            <view class="price">¥{{item.price}}</view>
            <view class="origin">¥{{item.originalPrice}}</view>
          </view>
          <button class="add-button" bindtap="addToCart" data-id="{{item.id}}">加入</button>
        </view>
      </view>
    </view>
  </view>
</view>
