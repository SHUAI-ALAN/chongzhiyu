.shop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.heading-kicker {
  color: #25b6a4;
  font-size: 22rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.heading-title {
  margin-top: 8rpx;
  color: #263238;
  font-size: 38rpx;
  font-weight: 900;
}

.cart-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 138rpx;
  height: 62rpx;
  padding: 0 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  background: #263238;
  border-radius: 999rpx;
}

.category-scroll {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.category-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 66rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  color: #6b7680;
  font-size: 25rpx;
  font-weight: 800;
  background: #ffffff;
  border: 1rpx solid rgba(38, 50, 56, 0.08);
  border-radius: 999rpx;
}

.category-pill.active {
  color: #ffffff;
  background: #f97361;
}

.product-list {
  display: grid;
  gap: 18rpx;
}

.product-card {
  display: grid;
  grid-template-columns: 220rpx 1fr;
  min-height: 220rpx;
  overflow: hidden;
}

.product-image {
  width: 220rpx;
  height: 100%;
}

.product-info {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: 22rpx;
}

.product-name {
  color: #263238;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.product-bottom {
  display: flex;
  align-items: end;
  justify-content: space-between;
  margin-top: 18rpx;
}

.origin {
  color: #9da8ae;
  font-size: 22rpx;
  text-decoration: line-through;
}

.add-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 62rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  background: #25b6a4;
  border-radius: 999rpx;
}
